# Environment variables for SWARA
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git

# ─── Groq LLM ───────────────────────────────────────────
# Get your API key at: https://console.groq.com
GROQ_API_KEY=

# ─── ElevenLabs TTS ─────────────────────────────────────
# Get your API key at: https://elevenlabs.io
ELEVENLABS_API_KEY=

# Voice ID — find available voices at:
# https://elevenlabs.io/docs/api-reference/voices
# Recommended for AAC: "Rachel" (21m00Tcm4TlvDq8ikWAM) or "Adam" (pNInz6obpgDQGcFmaJgB)
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
